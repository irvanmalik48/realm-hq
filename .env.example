# Environment
NODE_ENV=development

# Application URLs & Branding
NEXT_PUBLIC_SITE_NAME="Realm HQ"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BLOG_URL=http://localhost:3001

# gRPC Backend Endpoint
GRPC_API_URL=127.0.0.1:50051

# API Authentication Token (generated via realm-api cmd/token or HQ tokens page)
API_TOKEN=realm_tok_your_token_here

# Superadmin Email Allowlist (comma-separated for initial authorization)
SUPERADMIN_EMAILS=irvanma@gnuweeb.org
